# Example .env file for SMTP configuration
# Copy to .env and fill values (do NOT commit .env to version control)

SMTP_HOST=smtp.example.com
SMTP_USER=smtp_user@example.com
SMTP_PASS=your_smtp_password
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_FROM=no-reply@example.com
CONTACT_TO=you@example.com

# Resend (https://resend.com) API key and destination email
# Copy values into your Vercel Environment Variables as well: RESEND_API_KEY and TO_EMAIL
RESEND_API_KEY=your_resend_api_key_here
TO_EMAIL=you@example.com
